# ctest "manus.lorica_applied.compile_commands": every Manus translation unit in
# compile_commands.json is compiled with Lorica's settings (cmake -P; no Python).
#
#   cmake -DMANUS_EXPECT_FILE=<build>/lorica_applied/expect-<config>.cmake -P <this file>
#
# The expectations file is written by manus_write_lorica_expectations()
# (tests/CMakeLists.txt) from what cmake/LoricaHardening.cmake gives each profile:
#   GCC / Clang on Linux, every C/C++ unit: -fstack-protector-strong,
#     -fstack-clash-protection, -fcf-protection=full (x86-64) or
#     -mbranch-protection=standard (AArch64), -D_FORTIFY_SOURCE=3 in optimized
#     configurations, position independent code;
#   C++ units also: -D_GLIBCXX_ASSERTIONS, -D_LIBCPP_HARDENING_MODE=<FAST | EXTENSIVE>,
#     -include <lorica/unsafe_api.hpp>, -Werror=deprecated-declarations;
#   EXTENDED targets also: -ftrivial-auto-var-init=zero;
#   MSVC: /GS /sdl /guard:cf, /we4996 for C++, EXTENDED adds
#     _MSVC_STL_HARDENING=1 and _MSVC_STL_DESTRUCTOR_TOMBSTONES=1 (not run in the cloud).
# For a flag family the last spelling on the command line wins, so each family is
# judged by its last occurrence (a later -fno-stack-protector, -D_FORTIFY_SOURCE=0 or
# -fcf-protection=none cancels Lorica's). Entries outside the Manus sources (the build
# directory, _deps, third-party trees) are not judged. Any failing entry is named.
# When the check cannot run here, the output says MANUS_LORICA_NOT_CHECKED: <reason>
# and ctest reports the test as skipped (SKIP_REGULAR_EXPRESSION), never as passed.
cmake_minimum_required(VERSION 3.24)

if(NOT EXISTS "${MANUS_EXPECT_FILE}")
  message(FATAL_ERROR "expectations file not found: ${MANUS_EXPECT_FILE} (reconfigure the build)")
endif()
include("${MANUS_EXPECT_FILE}")

if(MANUS_NOT_CHECKED)
  message("MANUS_LORICA_NOT_CHECKED: ${MANUS_NOT_CHECKED}")
  return()
endif()
if(NOT EXISTS "${MANUS_COMPILE_COMMANDS}")
  message(FATAL_ERROR "compile_commands.json is missing: ${MANUS_COMPILE_COMMANDS}")
endif()
file(READ "${MANUS_COMPILE_COMMANDS}" database)
string(JSON entry_count LENGTH "${database}")

# The value that the last option of a family leaves in effect, or "" if none.
# <prefixes> are matched at the start of each argument.
function(last_of out args)
  set(prefixes ${ARGN})
  set(found "")
  foreach(arg IN LISTS args)
    foreach(prefix IN LISTS prefixes)
      string(FIND "${arg}" "${prefix}" at)
      if(at EQUAL 0)
        set(found "${arg}")
        break()
      endif()
    endforeach()
  endforeach()
  set(${out} "${found}" PARENT_SCOPE)
endfunction()

# -DNAME / /DNAME spellings, and the -UNAME that cancels them.
function(last_define out args name)
  last_of(found "${args}" "-D${name}" "/D${name}" "-U${name}" "/U${name}")
  string(REGEX REPLACE "^/" "-" found "${found}")
  set(${out} "${found}" PARENT_SCOPE)
endfunction()

function(require_last problems_var args expected)
  last_of(found "${args}" ${ARGN})
  if(NOT found STREQUAL expected)
    if(found STREQUAL "")
      set(found "absent")
    endif()
    set(${problems_var} "${${problems_var}};${expected} (in effect: ${found})" PARENT_SCOPE)
  endif()
endfunction()

function(require_define problems_var args name expected)
  last_define(found "${args}" "${name}")
  if(NOT found STREQUAL expected)
    if(found STREQUAL "")
      set(found "absent")
    endif()
    set(${problems_var} "${${problems_var}};${expected} (in effect: ${found})" PARENT_SCOPE)
  endif()
endfunction()

function(require_absent problems_var args)
  foreach(flag IN LISTS ARGN)
    list(FIND args "${flag}" at)
    if(NOT at EQUAL -1)
      set(${problems_var} "${${problems_var}};no ${flag}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
endfunction()

cmake_path(NORMAL_PATH MANUS_SOURCE_DIR OUTPUT_VARIABLE source_root)
cmake_path(NORMAL_PATH MANUS_BINARY_DIR OUTPUT_VARIABLE binary_root)
set(checked 0)
set(failures "")
math(EXPR last_index "${entry_count} - 1")
foreach(index RANGE 0 ${last_index})
  string(JSON directory GET "${database}" ${index} directory)
  string(JSON file GET "${database}" ${index} file)
  string(JSON command ERROR_VARIABLE no_command GET "${database}" ${index} command)
  if(no_command)
    # The "arguments" form: one argument per array element.
    string(JSON argument_count LENGTH "${database}" ${index} arguments)
    set(args "")
    math(EXPR last_argument "${argument_count} - 1")
    foreach(a RANGE 0 ${last_argument})
      string(JSON value GET "${database}" ${index} arguments ${a})
      list(APPEND args "${value}")
    endforeach()
  elseif(MANUS_TOOLCHAIN STREQUAL "msvc")
    separate_arguments(args WINDOWS_COMMAND "${command}")
  else()
    separate_arguments(args UNIX_COMMAND "${command}")
  endif()

  cmake_path(ABSOLUTE_PATH file BASE_DIRECTORY "${directory}" NORMALIZE OUTPUT_VARIABLE path)
  cmake_path(IS_PREFIX source_root "${path}" NORMALIZE in_sources)
  cmake_path(IS_PREFIX binary_root "${path}" NORMALIZE in_build)
  if(NOT in_sources OR in_build OR path MATCHES "/_deps/")
    continue()
  endif()
  math(EXPR checked "${checked} + 1")

  # The target owning the object: .../CMakeFiles/<target>.dir/...
  string(JSON output ERROR_VARIABLE no_output GET "${database}" ${index} output)
  if(no_output)
    set(output "${command}")
  endif()
  if(output MATCHES "CMakeFiles[/\\\\]([^/\\\\]+)\\.dir[/\\\\]")
    set(target "${CMAKE_MATCH_1}")
  else()
    set(target "")
  endif()
  list(FIND MANUS_TARGETS "${target}" registered)
  list(FIND MANUS_EXTENDED_TARGETS "${target}" extended)
  set(is_cxx TRUE)
  if(path MATCHES "\\.c$")
    set(is_cxx FALSE)
  endif()

  set(missing "")
  if(registered EQUAL -1)
    list(APPEND missing "target '${target}' did not go through manus_target()")
  endif()
  if(MANUS_TOOLCHAIN STREQUAL "gnu")
    # Lorica's include directory (Lorica::boundary).
    set(include_found FALSE)
    set(previous "")
    foreach(arg IN LISTS args)
      if(arg STREQUAL "-I${MANUS_LORICA_INCLUDE_DIR}" OR arg STREQUAL "-isystem${MANUS_LORICA_INCLUDE_DIR}" OR
         ((previous STREQUAL "-I" OR previous STREQUAL "-isystem") AND arg STREQUAL "${MANUS_LORICA_INCLUDE_DIR}"))
        set(include_found TRUE)
      endif()
      set(previous "${arg}")
    endforeach()
    if(NOT include_found)
      list(APPEND missing "-I${MANUS_LORICA_INCLUDE_DIR}")
    endif()
    require_last(missing "${args}" -fstack-protector-strong -fstack-protector -fno-stack-protector)
    require_last(missing "${args}" -fstack-clash-protection -fstack-clash-protection -fno-stack-clash-protection)
    if(MANUS_CONTROL_FLOW STREQUAL "-fcf-protection=full")
      require_last(missing "${args}" -fcf-protection=full -fcf-protection)
    else()
      require_last(missing "${args}" ${MANUS_CONTROL_FLOW} -mbranch-protection)
    endif()
    if(MANUS_EXPECT_FORTIFY)
      require_define(missing "${args}" _FORTIFY_SOURCE "-D_FORTIFY_SOURCE=${MANUS_EXPECT_FORTIFY}")
    else()
      require_absent(missing "${args}" -D_FORTIFY_SOURCE=0)
    endif()
    last_of(pic "${args}" -fPIC -fPIE -fpic -fpie -fno-PIC -fno-PIE -fno-pic -fno-pie)
    if(NOT pic MATCHES "^-f(PIC|PIE|pic|pie)$")
      list(APPEND missing "-fPIE or -fPIC (in effect: ${pic})")
    endif()
    if(NOT extended EQUAL -1)
      require_last(missing "${args}" -ftrivial-auto-var-init=zero -ftrivial-auto-var-init)
    endif()
    if(is_cxx)
      require_define(missing "${args}" _GLIBCXX_ASSERTIONS -D_GLIBCXX_ASSERTIONS)
      if(extended EQUAL -1)
        set(mode _LIBCPP_HARDENING_MODE_FAST)
      else()
        set(mode _LIBCPP_HARDENING_MODE_EXTENSIVE)
      endif()
      require_define(missing "${args}" _LIBCPP_HARDENING_MODE "-D_LIBCPP_HARDENING_MODE=${mode}")
      # The force-include: "-include <header>" (or -include<header>).
      list(FIND args "-include" at)
      set(forced FALSE)
      if(NOT at EQUAL -1)
        math(EXPR at "${at} + 1")
        list(LENGTH args arg_count)
        if(at LESS arg_count)
          list(GET args ${at} forced_header)
          if(forced_header STREQUAL MANUS_LORICA_HEADER)
            set(forced TRUE)
          endif()
        endif()
      endif()
      list(FIND args "-include${MANUS_LORICA_HEADER}" joined)
      if(NOT forced AND joined EQUAL -1)
        list(APPEND missing "-include ${MANUS_LORICA_HEADER}")
      endif()
      require_last(missing "${args}" -Werror=deprecated-declarations
        -Werror=deprecated-declarations -Wno-error=deprecated-declarations -Wno-deprecated-declarations)
    endif()
  elseif(MANUS_TOOLCHAIN STREQUAL "msvc")
    # Not run in the cloud (no MSVC there): written from cmake/LoricaHardening.cmake.
    require_last(missing "${args}" /GS /GS -GS)
    require_last(missing "${args}" /sdl /sdl -sdl)
    require_last(missing "${args}" /guard:cf /guard:cf -guard:cf)
    if(is_cxx)
      require_last(missing "${args}" /we4996 /we4996 /wd4996 -we4996 -wd4996)
      require_absent(missing "${args}" -D_CRT_SECURE_NO_WARNINGS /D_CRT_SECURE_NO_WARNINGS)
      if(NOT extended EQUAL -1)
        require_define(missing "${args}" _MSVC_STL_HARDENING -D_MSVC_STL_HARDENING=1)
        require_define(missing "${args}" _MSVC_STL_DESTRUCTOR_TOMBSTONES -D_MSVC_STL_DESTRUCTOR_TOMBSTONES=1)
      endif()
    endif()
  endif()
  list(REMOVE_ITEM missing "")
  if(missing)
    list(JOIN missing ", " missing_text)
    string(APPEND failures "\n  ${path} [${target}]: ${missing_text}")
  endif()
endforeach()

if(checked EQUAL 0)
  message(FATAL_ERROR "no Manus translation unit under ${source_root} in ${MANUS_COMPILE_COMMANDS}")
endif()
if(failures)
  message(FATAL_ERROR "Lorica's settings are missing from these compile commands:${failures}")
endif()
list(LENGTH MANUS_EXTENDED_TARGETS extended_count)
message(STATUS "Lorica's settings found in all ${checked} Manus compile commands (${extended_count} EXTENDED targets)")
