{
  "name": "manus",
  "version": "0.1.0",
  "description": "iPhone の Web UI からキーボードレス Windows 機 (ROG Ally X 等) へキーボード/マウス/ゲームパッド入力を注入するリモート入力サービス",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:frontend",
    "build:frontend": "node scripts/build-frontend.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p frontend/tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "set-pin": "tsx src/cli/set-pin.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ludiars/vestigium": "file:lib/vestigium",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
